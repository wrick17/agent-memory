// Generated by `npm run setup` (local/setup.mjs, docs/self-host.md). Setup never overwrites this file.
// OWNER_USER_ID is a Worker secret, not a variable. BACKUPS is the permanent R2 generation ledger, not a backup.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-memory",
	"account_id": "0123456789abcdef0123456789abcdef",
	"main": "src/worker.ts",
	"rules": [
		{
			"type": "Text",
			"globs": [
				"../local/*-player.js"
			],
			"fallthrough": true
		}
	],
	"compatibility_date": "2026-10-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"routes": [
		{
			"pattern": "memory.example.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "ACCOUNT",
				"class_name": "AccountStore"
			},
			{
				"name": "PROFILE",
				"class_name": "ProfileStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"AccountStore",
				"ProfileStore"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "BACKUPS",
			"bucket_name": "agent-memory-ledger"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORS",
			"index_name": "agent-memory-cards"
		}
	],
	"vars": {
		"RESOURCE_URL": "https://memory.example.com/mcp",
		"CLERK_ISSUER": "https://clerk.example.com",
		"CLERK_FRONTEND_API": "https://clerk.example.com",
		"CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZXhhbXBsZS5jb20k",
		"REQUIRED_SCOPE": "memory",
		"DASHBOARD_ORIGIN": "https://memory.example.com",
		"EMBEDDINGS": "on",
		"ROUTING_DEFAULTS": "github.com/your-org/*=work,github.com/your-user/*=personal",
		"IMPORT_PROFILES": ""
	}
}
