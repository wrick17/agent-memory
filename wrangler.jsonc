// Agent Memory Worker. Recheck the custom-domain DNS for conflicts before deployment.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-memory",
	"routes": [{ "pattern": "memory.wrick17.com", "custom_domain": true }],
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"durable_objects": {
		"bindings": [
			{ "name": "ACCOUNT", "class_name": "AccountStore" },
			{ "name": "PROFILE", "class_name": "ProfileStore" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountStore", "ProfileStore"] }],
	"ai": { "binding": "AI" },
	"vectorize": [{ "binding": "VECTORS", "index_name": "agent-memory-cards" }],
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "agent-memory-backups" }],
	"vars": {
		"RESOURCE_URL": "https://memory.wrick17.com/mcp",
		// Expected issuer; confirm against https://clerk.memory.wrick17.com/.well-known/openid-configuration once DNS resolves (G1).
		"CLERK_ISSUER": "https://clerk.memory.wrick17.com",
		"CLERK_FRONTEND_API": "https://clerk.memory.wrick17.com",
		"CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubWVtb3J5LndyaWNrMTcuY29tJA",
		"REQUIRED_SCOPE": "memory",
		"DASHBOARD_ORIGIN": "https://memory.wrick17.com",
		"EMBEDDINGS": "on",
		"ROUTING_DEFAULTS": "github.com/Sequoia-Engineering/*=work,github.com/Sequoia-US/*=work,github.com/pratyush-poddar_seq/*=work,github.com/wrick17/*=personal",
		// The one owner user in the production Clerk instance (public identifier, not a secret).
		"OWNER_USER_ID": "user_3LKQ6KGbDJZfXH8o4UfNqcq6mig"
	},
	"env": {
		// Test-only environment: AI and Vectorize are replaced by local fakes in vitest.config.ts.
		"test": {
			"durable_objects": {
				"bindings": [
					{ "name": "ACCOUNT", "class_name": "AccountStore" },
					{ "name": "PROFILE", "class_name": "ProfileStore" }
				]
			},
			"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "agent-memory-backups-test" }],
			"vars": {
				"RESOURCE_URL": "https://memory.test/mcp",
				"CLERK_ISSUER": "https://clerk.memory.test",
				"CLERK_FRONTEND_API": "https://clerk.memory.test",
				"CLERK_PUBLISHABLE_KEY": "pk_test_placeholder",
				"REQUIRED_SCOPE": "memory",
				"DASHBOARD_ORIGIN": "https://memory.test",
				"EMBEDDINGS": "on",
				"ROUTING_DEFAULTS": "github.com/Sequoia-Engineering/*=work,github.com/wrick17/*=personal,path:/Users/test/work=work",
				"OWNER_USER_ID": "user_testowner0000000000000000"
			}
		}
	}
}
