{
  "name": "agent-memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "src/",
    "local/setup.mjs",
    "docs/self-host.md",
    "wrangler.example.jsonc",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "setup": "node local/setup.mjs",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:local",
    "test:local": "node --test local/agent-memory.test.mjs local/batch.test.mjs local/corpus-upload.test.mjs local/migrate.test.mjs local/upload.test.mjs local/setup.test.mjs",
    "pack:self-host": "node local/package.mjs",
    "prepack": "node local/package.mjs --source-pack"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@types/node": "^24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=24"
  }
}
